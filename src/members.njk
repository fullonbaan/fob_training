<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members Library | FullOnBaan Training</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700;900&family=Work+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{
      --gold:#f6bc68; --gold-dk:#ba8738; --gold-faint:rgba(246,188,104,0.08); --gold-line:rgba(246,188,104,0.22);
      --bg:#060f1e; --bg2:#06132a; --surface:#0a1630; --surface-hi:#0d1a30; --ink:#f0e8d8; --ink-mid:rgba(212,196,178,0.78);
      --ink-lt:rgba(212,196,178,0.55); --border:rgba(246,188,104,0.14); --err:#f87171; --ok:#4ade80;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:linear-gradient(180deg,var(--bg2) 0%,var(--bg) 420px);background-color:var(--bg);color:var(--ink);font-family:'Work Sans',system-ui,sans-serif;font-size:15px;line-height:1.6;min-height:100vh;display:flex;flex-direction:column}
    a{color:var(--gold)}
    .site-nav{position:sticky;top:0;z-index:10;background:rgba(6,19,42,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
    .nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:68px;gap:16px}
    .nav-brand{font-family:'Noto Serif',serif;font-size:20px;font-weight:700;color:var(--gold);text-decoration:none;white-space:nowrap}
    .nav-brand span{color:var(--ink-mid);font-weight:400}
    .nav-right{display:flex;gap:18px;align-items:center}
    .nav-link{font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-mid);text-decoration:none}
    .nav-link:hover{color:var(--gold)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;border:1px solid transparent;border-radius:10px;background:linear-gradient(135deg,#f6bc68,#ba8738);color:#06132a;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;text-decoration:none;transition:filter .2s,box-shadow .2s}
    .btn:hover{filter:brightness(1.08);box-shadow:0 6px 18px rgba(246,188,104,.18)}
    .btn:disabled{opacity:.55;cursor:wait}
    .btn.ghost{background:transparent;color:var(--gold);border-color:var(--gold-line)}
    .btn.ghost:hover{background:var(--gold-faint);border-color:var(--gold)}
    .btn.sm{padding:9px 12px;font-size:11px;letter-spacing:.08em;white-space:nowrap}
    main{flex:1;width:100%;max-width:1200px;margin:0 auto;padding:48px 32px 72px}
    .eyebrow{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}
    h1{font-family:'Noto Serif',serif;font-weight:900;font-size:clamp(28px,4vw,42px);line-height:1.15;margin:10px 0 12px}
    .lede{color:var(--ink-mid);max-width:620px}
    .auth-wrap{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:start}
    .card{background:var(--surface);border:1px solid var(--gold-line);border-radius:18px;padding:32px}
    label{display:block;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-mid);margin:18px 0 8px}
    input{width:100%;padding:13px 14px;border:1px solid var(--gold-line);background:rgba(255,255,255,0.04);font:inherit;color:var(--ink);outline:none;border-radius:10px}
    input::placeholder{color:var(--ink-lt)}
    input:focus{border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-faint)}
    input.code{font-family:'DM Mono',monospace;font-size:18px;letter-spacing:.14em;text-transform:uppercase}
    .form-actions{margin-top:22px;display:flex;flex-direction:column;gap:12px}
    .form-actions .btn{width:100%}
    .linkbtn{background:none;border:0;color:var(--gold);font:inherit;font-size:14px;cursor:pointer;text-decoration:underline;text-underline-offset:3px;padding:0;align-self:flex-start}
    .msg{margin-top:16px;padding:12px 14px;font-size:14px;display:none;border-left:3px solid;border-radius:6px}
    .msg.show{display:block}
    .msg.err{background:rgba(248,113,113,.08);border-color:var(--err);color:#fca5a5}
    .msg.ok{background:rgba(74,222,128,.08);border-color:var(--ok);color:#86efac}
    .points{list-style:none;margin-top:28px;display:grid;gap:14px}
    .points li{display:flex;gap:12px;color:var(--ink-mid);font-size:14px}
    .points b{color:var(--ink)}
    .points .ic{flex:0 0 28px;height:28px;border:1px solid var(--gold-line);border-radius:8px;color:var(--gold);display:grid;place-items:center;font-size:13px;background:var(--gold-faint)}
    .lib-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px}
    .who{font-family:'DM Mono',monospace;font-size:12px;color:var(--ink-lt)}
    .tabs{display:flex;gap:8px;margin:0 0 10px;flex-wrap:wrap}
    .tab{padding:7px 14px;border:1px solid var(--border);border-radius:999px;background:var(--surface);font:inherit;font-size:12px;font-weight:600;letter-spacing:.04em;cursor:pointer;color:var(--ink-mid)}
    .tab[aria-pressed="true"]{border-color:var(--gold);background:var(--gold);color:#06132a}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
    .book{background:var(--surface);border:1px solid var(--border);border-radius:14px;display:flex;flex-direction:column;overflow:hidden}
    .book-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px;flex:1}
    .book-name{font-family:'Noto Serif',serif;font-weight:700;font-size:16px;line-height:1.3}
    .book-meta{font-size:12px;color:var(--ink-lt);font-family:'DM Mono',monospace}
    .book-actions{display:flex;gap:8px;margin-top:auto}
    .empty{padding:40px;text-align:center;border:1px dashed var(--gold-line);border-radius:14px;color:var(--ink-mid)}
    .notice{background:var(--gold-faint);border:1px solid var(--gold-line);border-radius:10px;padding:12px 16px;font-size:14px;margin-bottom:22px;color:var(--ink)}
    .video-note{background:rgba(129,140,248,.07);border:1px solid rgba(129,140,248,.25);border-radius:10px;padding:12px 16px;font-size:13px;margin-bottom:22px;color:var(--ink-mid)}
    .loading{display:grid;place-items:center;min-height:280px;color:var(--ink-lt);font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.2em}
    .libbar{position:sticky;top:68px;z-index:5;background:rgba(6,15,30,.94);backdrop-filter:blur(10px);padding:12px 0;margin:0 0 8px;border-bottom:1px solid var(--border)}
    .jump{display:flex;gap:8px;overflow-x:auto;scrollbar-width:thin;padding-bottom:2px}
    .chip{flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--ink);text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap}
    .chip:hover{border-color:var(--gold);color:var(--gold)}
    .chip b{font-family:'DM Mono',monospace;font-weight:500;color:var(--gold);font-size:11px}
    .cat{padding:34px 0 10px;scroll-margin-top:170px}
    .cat + .cat{border-top:1px solid var(--border)}
    .cat-head{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap}
    .cat-badge{width:52px;height:52px;border-radius:14px;flex:0 0 auto;display:grid;place-items:center;background:linear-gradient(135deg,rgba(246,188,104,.2),rgba(186,135,56,.08));border:1px solid var(--gold-line);font-family:'DM Mono',monospace;font-size:12px;font-weight:500;color:var(--gold);letter-spacing:.06em;text-transform:uppercase}
    .cat-name{font-family:'Noto Serif',serif;font-weight:900;font-size:clamp(20px,2.4vw,26px);line-height:1.2;margin:4px 0 2px}
    .cat-meta{font-family:'DM Mono',monospace;font-size:12px;color:var(--ink-lt)}
    .shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(188px,1fr));gap:20px}
    .eb{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s,border-color .2s}
    .eb:hover{box-shadow:0 12px 30px rgba(0,0,0,.35);transform:translateY(-2px);border-color:var(--gold-line)}
    .thumb{position:relative;display:block;aspect-ratio:3/4;background:#0b1428;border-bottom:1px solid var(--border);overflow:hidden}
    .thumb img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
    .thumb .ph{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:18px;
      background:radial-gradient(120% 80% at 50% 0%,#1b2f55 0%,#081226 62%);color:var(--gold);outline:1px solid rgba(246,188,104,.22);outline-offset:-9px}
    .thumb .ph small{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.3em;color:var(--gold-dk);margin-bottom:12px}
    .thumb .ph span{font-family:'Noto Serif',serif;font-weight:700;font-size:16px;line-height:1.25}
    .thumb .ph.xls{background:radial-gradient(120% 80% at 50% 0%,#14432c 0%,#081a12 62%)}
    .thumb .pages{position:absolute;right:8px;bottom:8px;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.1em;background:rgba(6,15,30,.85);color:var(--gold);padding:3px 7px;border-radius:5px}
    .eb-body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:6px;flex:1}
    .eb-title{font-weight:600;font-size:14px;line-height:1.35}
    .eb-sub{font-family:'DM Mono',monospace;font-size:11px;color:var(--ink-lt)}
    .eb-actions{display:flex;gap:6px;margin-top:auto;padding-top:8px}
    .eb-actions .btn{flex:1;padding:9px 6px;font-size:10.5px;letter-spacing:.06em}
    .soon{font-size:14px;color:var(--ink-lt);padding:18px;border:1px dashed var(--gold-line);border-radius:12px;background:var(--surface)}
    .sec-title{display:flex;align-items:baseline;gap:10px;margin:26px 0 14px;padding-bottom:8px;border-bottom:1px dashed var(--gold-line);font-family:'Noto Serif',serif;font-weight:700;font-size:17px;color:var(--ink)}
    .sec-title:first-of-type{margin-top:4px}
    .sec-title b{font-family:'DM Mono',monospace;font-weight:500;font-size:11px;color:var(--gold);letter-spacing:.06em}
    .flist{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px;margin-top:12px}
    .frow{display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:12px}
    .frow:hover{border-color:var(--gold-line)}
    .fext{flex:0 0 44px;height:44px;border-radius:9px;display:grid;place-items:center;background:rgba(74,222,128,.07);border:1px solid rgba(74,222,128,.22);color:#86efac;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.06em}
    .fmid{flex:1;min-width:0}.fmid .eb-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .more{margin-top:40px;padding-top:30px;border-top:1px solid var(--gold-line)}
    footer{border-top:1px solid var(--border);padding:22px 32px;font-size:12px;color:var(--ink-lt);text-align:center}
    footer a{color:var(--ink-mid)}
    [hidden]{display:none!important}
    @media(max-width:520px){.nav-brand{font-size:18px}.nav-brand span{display:none}.nav-inner{gap:10px}}
    @media(max-width:860px){.auth-wrap{grid-template-columns:1fr;gap:28px}.nav-inner,main{padding-left:16px;padding-right:16px}main{padding-top:28px}.card{padding:22px}.hide-sm{display:none}.points{display:none}.lede{font-size:14px}
      .shelf{grid-template-columns:repeat(2,1fr);gap:12px}.eb-actions{flex-direction:column}.libbar{top:68px}}
  </style>
</head>
<body>
<nav class="site-nav">
  <div class="nav-inner">
    <a class="nav-brand" href="/">FullOnBaan <span>Members Library</span></a>
    <div class="nav-right">
      <a class="nav-link hide-sm" href="/catalog/">Catalog</a>
      <a class="nav-link hide-sm" href="/contact/">Help</a>
      <button class="btn sm ghost" id="logoutBtn" hidden>Sign out</button>
    </div>
  </div>
</nav>

<main>
  <div id="view-loading" class="loading">LOADING…</div>

  <!-- ── Sign in ───────────────────────────────────────────── -->
  <section id="view-auth" hidden>
    <div class="auth-wrap">
      <div>
        <div class="eyebrow">Members Library</div>
        <h1>Your Infor LN eBook library</h1>
        <p class="lede">Sign in with the email you used at checkout and the access code we emailed you after payment. Every eBook you've bought is here, ready to read online or download.</p>
        <ul class="points">
          <li><span class="ic">&#9670;</span><span><b>Only your eBooks.</b> Your library shows exactly what you purchased — combos and the Full eBook Library unlock every eBook inside them.</span></li>
          <li><span class="ic">&#9670;</span><span><b>Read or download.</b> Open an eBook in your browser or save the PDF to keep. Examples, scripts and Excel tools download directly.</span></li>
          <li><span class="ic">&#9670;</span><span><b>Always up to date.</b> New editions appear here automatically — no need to buy again.</span></li>
          <li><span class="ic">&#9670;</span><span><b>Personal copy.</b> Each PDF is licensed to you and carries your name and email.</span></li>
        </ul>
      </div>

      <div class="card">
        <form id="loginForm" novalidate>
          <div class="eyebrow">Sign in</div>
          <label for="email">Email address</label>
          <input id="email" type="email" autocomplete="email" required placeholder="you@company.com">
          <label for="code">Access code</label>
          <input id="code" class="code" autocomplete="one-time-code" required placeholder="FOB-XXXXX-XXXXX" maxlength="17" spellcheck="false">
          <div class="form-actions">
            <button class="btn" type="submit" id="loginBtn">Open my library</button>
            <button class="linkbtn" type="button" id="showResend">Lost your code? Email me a new one</button>
          </div>
          <div class="msg" id="loginMsg" role="alert"></div>
        </form>

        <form id="resendForm" novalidate hidden>
          <div class="eyebrow">New access code</div>
          <p style="margin-top:10px;color:var(--ink-mid);font-size:14px;">Enter the email you used to buy. We'll send a fresh code there — your old code will stop working.</p>
          <label for="rEmail">Email address</label>
          <input id="rEmail" type="email" autocomplete="email" required>
          <div class="form-actions">
            <button class="btn" type="submit" id="resendBtn">Send new code</button>
            <button class="linkbtn" type="button" id="showLogin">Back to sign in</button>
          </div>
          <div class="msg" id="resendMsg" role="alert"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ── Library ───────────────────────────────────────────── -->
  <section id="view-lib" hidden>
    <div class="lib-head">
      <div>
        <div class="eyebrow">My library</div>
        <h1 id="hello">Welcome back</h1>
        <div class="who" id="who"></div>
      </div>
      <a class="btn ghost sm" href="/pricing/">Get more eBooks</a>
    </div>
    <div class="notice" id="libNotice" hidden></div>
    <div class="video-note">&#x1F3AC; Bought a <b>video course</b> or <b>combo</b>? Video lectures are delivered separately to your email. This library holds your eBooks.</div>
    <div class="libbar">
      <div class="tabs" role="group" aria-label="Track">
        <button class="tab" data-t="all" aria-pressed="true">All</button>
        <button class="tab" data-t="Technical" aria-pressed="false">Technical</button>
        <button class="tab" data-t="Functional" aria-pressed="false">Functional</button>
        <button class="tab" data-t="Strategy" aria-pressed="false">Strategy</button>
      </div>
      <nav class="jump" id="jump" aria-label="Jump to eBook kit"></nav>
    </div>
    <div id="shelves"></div>
    <section class="more" id="more" hidden>
      <div class="cat-head"><div><div class="eyebrow">Add to your library</div><h2 class="cat-name">More eBook kits</h2></div></div>
      <div class="grid" id="moreGrid"></div>
    </section>
  </section>
</main>

<footer>&copy; <span id="yr"></span> FullOnBaan Education · Personal licence — please don't share your code or files. · <a href="/terms/">Terms</a> · <a href="mailto:support@fullonbaan.com">support@fullonbaan.com</a></footer>

{% raw %}
<script>
(function(){
  'use strict';
  var API = '/api/member';
  var $ = function(id){ return document.getElementById(id); };
  var state = { lib:null, catalog:null, files:{}, track:'all' };
  $('yr').textContent = new Date().getFullYear();

  var ERRORS = {
    login:'Your session has ended. Please sign in again.',
    forbidden:'That eBook isn’t in your library.',
    limit:'You’ve reached the download limit for that eBook. Write to support@fullonbaan.com and we’ll reset it.',
    missing:'That eBook is being updated right now. Please try again shortly, or contact support.',
    unknown:'Unknown eBook.', blocked:'Please open downloads from this page.'
  };

  function show(view){ ['loading','auth','lib'].forEach(function(v){ $('view-'+v).hidden = (v!==view); }); $('logoutBtn').hidden = (view!=='lib'); }
  function msg(el, text, kind){ el.textContent = text; el.className = 'msg show ' + (kind||'err'); }
  function clearMsg(el){ el.className = 'msg'; el.textContent=''; }

  function api(action, body){
    var opt = body ? { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body), credentials:'same-origin' }
                   : { credentials:'same-origin' };
    return fetch(API + '?action=' + action, opt).then(function(r){
      return r.json().catch(function(){ return {}; }).then(function(d){ d._status = r.status; return d; });
    });
  }

  // Code input: auto-format to FOB-XXXXX-XXXXX
  function codeBody(v){ var s = String(v||'').toUpperCase().replace(/[^A-Z0-9]/g,''); if (s.indexOf('FOB') === 0) s = s.slice(3); return s; }
  $('code').addEventListener('input', function(e){
    if (e.inputType && e.inputType.indexOf('delete') === 0) { e.target.value = e.target.value.toUpperCase(); return; }
    var raw = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,''), pre = raw.indexOf('FOB') === 0;
    var s = codeBody(raw).slice(0,10);
    e.target.value = (pre ? 'FOB-' : '') + s.slice(0,5) + (s.length>5 ? '-' + s.slice(5) : '');
  });

  $('showResend').onclick = function(){ $('loginForm').hidden = true; $('resendForm').hidden = false; $('rEmail').value = $('email').value; $('rEmail').focus(); };
  $('showLogin').onclick  = function(){ $('resendForm').hidden = true; $('loginForm').hidden = false; };

  $('loginForm').addEventListener('submit', function(e){
    e.preventDefault(); clearMsg($('loginMsg'));
    var email = $('email').value.trim(), code = $('code').value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return msg($('loginMsg'), 'Please enter a valid email address.');
    if (codeBody(code).length !== 10) return msg($('loginMsg'), 'Your access code looks like FOB-XXXXX-XXXXX.');
    $('loginBtn').disabled = true; $('loginBtn').textContent = 'Checking…';
    api('login', { email:email, code:code }).then(function(d){
      if (d.ok) { try{ localStorage.setItem('fob_mem_email', email); }catch(_){} return loadLibrary(); }
      msg($('loginMsg'), d.error || 'Sign-in failed. Please try again.');
    }).catch(function(){ msg($('loginMsg'), 'Network error. Please check your connection.'); })
      .then(function(){ $('loginBtn').disabled = false; $('loginBtn').textContent = 'Open my library'; });
  });

  $('resendForm').addEventListener('submit', function(e){
    e.preventDefault(); clearMsg($('resendMsg'));
    var email = $('rEmail').value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return msg($('resendMsg'), 'Please enter a valid email address.');
    $('resendBtn').disabled = true;
    api('resend', { email:email }).then(function(d){
      if (d.ok) msg($('resendMsg'), d.message, 'ok'); else msg($('resendMsg'), d.error || 'Could not send. Try again.');
    }).catch(function(){ msg($('resendMsg'), 'Network error.'); })
      .then(function(){ setTimeout(function(){ $('resendBtn').disabled = false; }, 4000); });
  });

  $('logoutBtn').onclick = function(){ api('logout', {}).then(function(){ state.lib = null; show('auth'); }); };

  Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(t){
    t.onclick = function(){ state.track = t.getAttribute('data-t');
      Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(x){ x.setAttribute('aria-pressed', String(x===t)); });
      render(); };
  });

  function el(tag, cls, text){ var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
  function fmtSize(b){ return b > 1048576 ? (b/1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b/1024)) + ' KB'; }
  function fileLink(g, id, mode){ return API + '?action=file&mode=' + mode + '&g=' + encodeURIComponent(g) + '&f=' + encodeURIComponent(id); }
  var KIND = { pdf:'PDF', xlsx:'Excel', xlsm:'Excel', xls:'Excel', csv:'CSV', docx:'Word', doc:'Word', pptx:'PowerPoint', ppt:'PowerPoint', zip:'ZIP', txt:'Text' };
  var ORDER = ['dev','adm','ext','bod','ion','os','idm','lnapi','dom','fin','mfg','log','whs','pln','mst','cloud','ai'];
  function sortKeys(keys){ return keys.sort(function(a,b){ var x=ORDER.indexOf(a), y=ORDER.indexOf(b); return (x<0?99:x)-(y<0?99:y); }); }

  function ebookCard(g, f){
    var lim = state.lib.limit, card = el('article','eb'), isPdf = !f.ext || f.ext === 'pdf';
    var th = el('a','thumb'); th.href = fileLink(g, f.id, isPdf ? 'view' : 'download');
    if (isPdf) { th.target = '_blank'; th.rel = 'noopener'; }
    th.title = (isPdf ? 'Read ' : 'Download ') + f.title;
    var ph = el('div','ph' + (isPdf ? '' : ' xls')); ph.appendChild(el('small',null,'FULLONBAAN')); ph.appendChild(el('span',null,f.title)); th.appendChild(ph);
    if (f.thumb) {
      var img = new Image(); img.alt = ''; img.loading = 'lazy'; img.decoding = 'async';
      img.onload = function(){ ph.remove(); }; img.onerror = function(){ img.remove(); };
      img.src = f.thumb; th.appendChild(img);
    }
    th.appendChild(el('span','pages',(KIND[f.ext] || String(f.ext || 'file').toUpperCase()) + ' · ' + fmtSize(f.size)));
    card.appendChild(th);
    var body = el('div','eb-body');
    body.appendChild(el('div','eb-title', f.title));
    var sub = el('div','eb-sub', 'Opened ' + f.opens + ' of ' + lim); body.appendChild(sub);
    var acts = el('div','eb-actions'), links = [th];
    if (isPdf) { var v = el('a','btn sm','Read online'); v.href = fileLink(g, f.id, 'view'); v.target = '_blank'; v.rel = 'noopener'; acts.appendChild(v); links.push(v); }
    var d = el('a','btn sm ' + (isPdf ? 'ghost' : ''),'Download'); d.href = fileLink(g, f.id, 'download'); acts.appendChild(d); links.push(d);
    links.forEach(function(x){ x.addEventListener('click', function(){ f.opens++; sub.textContent = 'Opened ' + f.opens + ' of ' + lim; }); });
    body.appendChild(acts); card.appendChild(body);
    return card;
  }

  // Scripts, examples, spreadsheets: a compact row (they are downloads, not books)
  function fileRow(g, f){
    var lim = state.lib.limit, row = el('div','frow');
    row.appendChild(el('span','fext', String(f.ext || 'file').toUpperCase().slice(0,5)));
    var mid = el('div','fmid'); mid.appendChild(el('div','eb-title', f.title));
    var sub = el('div','eb-sub', fmtSize(f.size) + ' · downloaded ' + f.opens + ' of ' + lim); mid.appendChild(sub); row.appendChild(mid);
    var d = el('a','btn sm ghost','Download'); d.href = fileLink(g, f.id, 'download');
    d.addEventListener('click', function(){ f.opens++; sub.textContent = fmtSize(f.size) + ' · downloaded ' + f.opens + ' of ' + lim; });
    row.appendChild(d); return row;
  }

  function short(name){ return name.replace(/^Infor (LN )?/,''); }

  function render(){
    var lib = state.lib, cat = state.catalog, files = state.files || {};
    var shelves = $('shelves'), jump = $('jump'), more = $('moreGrid');
    shelves.innerHTML = ''; jump.innerHTML = ''; more.innerHTML = '';
    var owned = {}; lib.owned.forEach(function(k){ owned[k] = true; });
    var inTrack = function(k){ return state.track === 'all' || cat[k].track === state.track; };
    var mine = sortKeys(lib.owned.filter(function(k){ return cat[k] && inTrack(k); }));
    var others = sortKeys(Object.keys(cat).filter(function(k){ return !owned[k] && inTrack(k); }));

    if (!lib.owned.length) {
      var em = el('div','empty'); em.appendChild(document.createTextNode('No eBooks in your library yet. '));
      var a0 = el('a',null,'Browse eBooks'); a0.href = '/pricing/'; em.appendChild(a0); shelves.appendChild(em);
    } else if (!mine.length) {
      shelves.appendChild(el('div','empty','You don’t own any ' + state.track + ' eBooks yet.'));
    }

    mine.forEach(function(k){
      var b = cat[k], list = files[k] || [];
      var chip = el('a','chip'); chip.href = '#cat-' + k; chip.appendChild(document.createTextNode(short(b.name)));
      chip.appendChild(el('b',null,String(list.length))); jump.appendChild(chip);

      var sec = el('section','cat'); sec.id = 'cat-' + k;
      var head = el('div','cat-head');
      head.appendChild(el('div','cat-badge', k));
      var tx = el('div'); tx.appendChild(el('div','eyebrow', b.track));
      tx.appendChild(el('h2','cat-name', b.name));
      var nSec = list.reduce(function(a, f){ if (f.section && a.indexOf(f.section) < 0) a.push(f.section); return a; }, []).length;
      tx.appendChild(el('div','cat-meta', list.length + (list.length === 1 ? ' file' : ' files') + (nSec ? ' · ' + nSec + (nSec === 1 ? ' section' : ' sections') : '')));
      head.appendChild(tx); sec.appendChild(head);
      if (!list.length) sec.appendChild(el('div','soon','Your eBooks for this kit are being prepared and will appear here automatically — no need to sign in again.'));
      else {
        // group by section (sub-folder); files in the kit's own folder come first, without a heading
        var groups = [], at = {};
        list.forEach(function(f){ var key = f.section || ''; if (!(key in at)) { at[key] = groups.length; groups.push({ name:key, files:[] }); } groups[at[key]].files.push(f); });
        var multi = groups.length > 1 || (groups[0] && groups[0].name);
        groups.forEach(function(gr){
          if (multi && gr.name) {
            var h = el('div','sec-title'); h.appendChild(el('span',null,gr.name)); h.appendChild(el('b',null,gr.files.length + (gr.files.length === 1 ? ' file' : ' files')));
            sec.appendChild(h);
          }
          var pdfs = gr.files.filter(function(f){ return !f.ext || f.ext === 'pdf'; }), others = gr.files.filter(function(f){ return f.ext && f.ext !== 'pdf'; });
          if (pdfs.length) { var shelf = el('div','shelf'); pdfs.forEach(function(f){ shelf.appendChild(ebookCard(k, f)); }); sec.appendChild(shelf); }
          if (others.length) { var ul = el('div','flist'); others.forEach(function(f){ ul.appendChild(fileRow(k, f)); }); sec.appendChild(ul); }
        });
      }
      shelves.appendChild(sec);
    });
    $('jump').hidden = mine.length < 2;

    others.forEach(function(k){
      var b = cat[k], card = el('article','book');
      var body = el('div','book-body'); body.appendChild(el('div','eyebrow', b.track));
      body.appendChild(el('div','book-name', b.name));
      if (b.count) body.appendChild(el('div','book-meta', b.count + (b.count === 1 ? ' file' : ' files')));
      var acts = el('div','book-actions'), buy = el('a','btn sm ghost','Get this kit'); buy.href = '/pricing/'; acts.appendChild(buy);
      body.appendChild(acts); card.appendChild(body); more.appendChild(card);
    });
    $('more').hidden = !others.length;
  }

  function loadLibrary(){
    return api('me').then(function(d){
      if (d._status !== 200 || !d.library) { show('auth'); return false; }
      state.lib = d.library; state.catalog = d.catalog; state.files = d.files || {};
      $('hello').textContent = d.library.name ? 'Welcome back, ' + d.library.name.split(' ')[0] : 'Welcome back';
      $('who').textContent = d.library.email + ' · ' + d.library.owned.length + ' eBook kit' + (d.library.owned.length===1?'':'s');
      show('lib'); render(); return true;
    }).catch(function(){ show('auth'); return false; });
  }

  // Boot: show any error passed back from a file redirect, then try the existing session.
  var params = new URLSearchParams(location.search), e = params.get('e');
  try { var saved = localStorage.getItem('fob_mem_email'); if (saved) $('email').value = saved; } catch(_){}
  if (params.get('email')) $('email').value = params.get('email');
  if (e || params.get('email')) history.replaceState(null, '', '/members/');
  loadLibrary().then(function(ok){
    if (e && ERRORS[e]) {
      if (ok && e !== 'login') { $('libNotice').textContent = ERRORS[e]; $('libNotice').hidden = false; }
      else msg($('loginMsg'), ERRORS[e]);
    }
  });
})();
</script>
{% endraw %}
</body>
</html>
